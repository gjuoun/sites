{
  "name": "@gjuoun/bigface-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Bigface's component library: 63 shadcn primitives, the Bigface wrappers and palette-driven tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjuoun/sites.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "shadcn",
    "tailwindcss",
    "react",
    "bigface",
    "theme"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/styles/tailwind.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./theme.css": "./src/styles/theme.css",
    "./themes/*": "./src/themes/*",
    "./tokens.css": "./src/styles/tokens.css",
    "./styles.css": "./src/styles/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ui:drift": "bun run scripts/ui-drift.ts",
    "ui:theme": "bun run scripts/theme-check.ts",
    "theme:sync": "bun run scripts/gen-tokens.ts",
    "theme:check": "bun run scripts/gen-tokens.ts --check",
    "test": "bun test src scripts"
  },
  "dependencies": {
    "cn": "^0.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@shadcn/react": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vaul": "^1.1.2"
  }
}
