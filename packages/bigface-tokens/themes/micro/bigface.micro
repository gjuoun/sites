# Bigface — https://github.com/gjuoun/bigface-theme
# Install: copy to ~/.config/micro/colorschemes/bigface.micro, then in micro: set colorscheme bigface
# Needs a truecolor terminal (COLORTERM=truecolor).
color-link default "#e8e9e1,#252925"
color-link comment "#8c8f89,#252925"
color-link identifier "#00c853,#252925"
color-link identifier.class "#c6ff00,#252925"
color-link identifier.macro "#fc5d23,#252925"
color-link identifier.var "#00c853,#252925"
color-link constant "#ae81ff,#252925"
color-link constant.string "#e5e500,#252925"
color-link constant.string.url "underline #00b0ff,#252925"
color-link constant.number "#fc5d23,#252925"
color-link constant.bool "#ae81ff,#252925"
color-link constant.specialChar "#fc5d23,#252925"
color-link statement "#00b0ff,#252925"
color-link symbol "#e8e9e1,#252925"
color-link symbol.operator "#ffeb3b,#252925"
color-link symbol.brackets "#e8e9e1,#252925"
color-link symbol.tag "#40c4ff,#252925"
color-link preproc "#00b0ff,#252925"
color-link type "#66d9ef,#252925"
color-link type.keyword "#00b0ff,#252925"
color-link special "#c6ff00,#252925"
color-link underlined "underline #00b0ff,#252925"
color-link error "bold #fc5d23,#252925"
color-link todo "bold #fc5d23,#252925"
color-link hlsearch "#e8e9e1,#4b4e49"
color-link selection "#e8e9e1,#4b4e49"
color-link statusline "#8c8f89,#3c403c"
color-link statusline.inactive "#8c8f89,#3c403c"
color-link tabbar "#8c8f89,#3c403c"
color-link tabbar.active "#e8e9e1,#252925"
color-link indent-char "#3c403c,#252925"
color-link line-number "#8c8f89,#252925"
color-link current-line-number "#e8e9e1,#4b4e49"
color-link gutter-info "#40c4ff,#252925"
color-link gutter-error "#fc5d23,#252925"
color-link gutter-warning "#ffeb3b,#252925"
color-link diff-added "#00c853"
color-link diff-modified "#40c4ff"
color-link diff-deleted "#fc5d23"
color-link cursor-line "#4b4e49"
color-link color-column "#3c403c"
color-link match-brace "#e8e9e1,#4b4e49"
color-link message "#e8e9e1,#4b4e49"
color-link error-message "#fc5d23,#4b4e49"
color-link divider "#3c403c,#252925"
color-link scrollbar "#8c8f89,#252925"
