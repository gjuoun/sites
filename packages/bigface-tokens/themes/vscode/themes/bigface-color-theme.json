{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bigface",
  "type": "dark",
  "colors": {
    "foreground": "#d9d9d4",
    "focusBorder": "#00b0ff",
    "widget.shadow": "#333333",
    "selection.background": "#3b514d",
    "descriptionForeground": "#75715e",
    "errorForeground": "#fc5d23",
    "textLink.foreground": "#00b0ff",
    "textLink.activeForeground": "#c6ff00",
    "textCodeBlock.background": "#333333",
    "icon.foreground": "#75715e",
    "editor.background": "#252925",
    "editor.foreground": "#d9d9d4",
    "editorCursor.foreground": "#f8f8f0",
    "editor.lineHighlightBackground": "#3b3c32",
    "editor.selectionBackground": "#646464",
    "editor.inactiveSelectionBackground": "#3b514d",
    "editor.findMatchBackground": "#646464",
    "editor.findMatchHighlightBackground": "#3b514d",
    "editorLineNumber.foreground": "#6e6b68",
    "editorLineNumber.activeForeground": "#d9d9d4",
    "editorIndentGuide.background1": "#333333",
    "editorIndentGuide.activeBackground1": "#494848",
    "editorRuler.foreground": "#333333",
    "editorWhitespace.foreground": "#494848",
    "editorBracketMatch.background": "#3b514d",
    "editorBracketMatch.border": "#00b0ff",
    "editorError.foreground": "#fc5d23",
    "editorWarning.foreground": "#ffeb3b",
    "editorInfo.foreground": "#40c4ff",
    "editorGutter.background": "#252925",
    "editorGutter.addedBackground": "#00c853",
    "editorGutter.modifiedBackground": "#40c4ff",
    "editorGutter.deletedBackground": "#fc5d23",
    "editorWidget.background": "#3b3c32",
    "editorWidget.border": "#494848",
    "editorSuggestWidget.selectedBackground": "#3b514d",
    "editorHoverWidget.background": "#3b3c32",
    "peekViewEditor.background": "#333333",
    "peekViewResult.background": "#3b3c32",
    "peekViewTitle.background": "#3b3c32",
    "diffEditor.insertedTextBackground": "#00c85330",
    "diffEditor.removedTextBackground": "#fc5d2330",
    "activityBar.background": "#333333",
    "activityBar.foreground": "#d9d9d4",
    "activityBar.inactiveForeground": "#6e6b68",
    "activityBar.border": "#333333",
    "activityBarBadge.background": "#00b0ff",
    "activityBarBadge.foreground": "#252925",
    "sideBar.background": "#333333",
    "sideBar.foreground": "#75715e",
    "sideBar.border": "#333333",
    "sideBarTitle.foreground": "#d9d9d4",
    "sideBarSectionHeader.background": "#3b3c32",
    "list.activeSelectionBackground": "#3b514d",
    "list.activeSelectionForeground": "#d9d9d4",
    "list.inactiveSelectionBackground": "#3b3c32",
    "list.hoverBackground": "#3b3c32",
    "list.highlightForeground": "#c6ff00",
    "list.focusBackground": "#3b514d",
    "tab.activeBackground": "#252925",
    "tab.activeForeground": "#d9d9d4",
    "tab.activeBorderTop": "#00b0ff",
    "tab.inactiveBackground": "#333333",
    "tab.inactiveForeground": "#6e6b68",
    "tab.border": "#333333",
    "editorGroupHeader.tabsBackground": "#333333",
    "editorGroup.border": "#333333",
    "panel.background": "#252925",
    "panel.border": "#333333",
    "panelTitle.activeForeground": "#d9d9d4",
    "panelTitle.inactiveForeground": "#6e6b68",
    "panelTitle.activeBorder": "#00b0ff",
    "statusBar.background": "#333333",
    "statusBar.foreground": "#75715e",
    "statusBar.border": "#333333",
    "statusBar.noFolderBackground": "#3b3c32",
    "statusBar.debuggingBackground": "#fc5d23",
    "titleBar.activeBackground": "#333333",
    "titleBar.activeForeground": "#75715e",
    "titleBar.inactiveBackground": "#333333",
    "titleBar.border": "#333333",
    "input.background": "#333333",
    "input.border": "#494848",
    "input.foreground": "#d9d9d4",
    "input.placeholderForeground": "#6e6b68",
    "inputOption.activeBorder": "#00b0ff",
    "dropdown.background": "#3b3c32",
    "dropdown.border": "#494848",
    "button.background": "#00b0ff",
    "button.foreground": "#252925",
    "button.hoverBackground": "#40c4ff",
    "badge.background": "#00b0ff",
    "badge.foreground": "#252925",
    "scrollbarSlider.background": "#6e6b6860",
    "scrollbarSlider.hoverBackground": "#6e6b6890",
    "progressBar.background": "#00b0ff",
    "gitDecoration.addedResourceForeground": "#00c853",
    "gitDecoration.modifiedResourceForeground": "#40c4ff",
    "gitDecoration.deletedResourceForeground": "#fc5d23",
    "gitDecoration.untrackedResourceForeground": "#00c853",
    "gitDecoration.ignoredResourceForeground": "#6e6b68",
    "gitDecoration.conflictingResourceForeground": "#ffeb3b",
    "terminal.background": "#252925",
    "terminal.foreground": "#d9d9d4",
    "terminal.selectionBackground": "#646464",
    "terminalCursor.foreground": "#f8f8f0",
    "terminal.ansiBlack": "#494848",
    "terminal.ansiRed": "#fc5d23",
    "terminal.ansiGreen": "#00c853",
    "terminal.ansiYellow": "#e5e500",
    "terminal.ansiBlue": "#00b0ff",
    "terminal.ansiMagenta": "#ae81ff",
    "terminal.ansiCyan": "#66d9ef",
    "terminal.ansiWhite": "#d9d9d4",
    "terminal.ansiBrightBlack": "#6e6b68",
    "terminal.ansiBrightRed": "#fc5d23",
    "terminal.ansiBrightGreen": "#c6ff00",
    "terminal.ansiBrightYellow": "#ffeb3b",
    "terminal.ansiBrightBlue": "#40c4ff",
    "terminal.ansiBrightMagenta": "#ae81ff",
    "terminal.ansiBrightCyan": "#b3e5fc",
    "terminal.ansiBrightWhite": "#f8f8f0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#75715e"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#ffeb3b"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e5e500"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fc5d23"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#c6ff00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#00c853"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#b3e5fc"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#40c4ff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#00c853"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d9d9d4"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#40c4ff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#c6ff00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e5e500"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00b0ff"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00c853"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#fc5d23"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fc5d23"
      }
    }
  ]
}
