{
  "name": "@gjuoun/bigface-business-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bigface business theme for Tailwind: 63 stock shadcn components and one light+dark theme generated from the Bigface palettes.",
  "license": "MIT",
  "keywords": [
    "shadcn",
    "tailwindcss",
    "react",
    "bigface",
    "business"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/themes": "./src/lib/themes.ts",
    "./themes/*": "./src/themes/*",
    "./styles.css": "./src/styles/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "theme:sync": "bun run scripts/gen-tokens.ts",
    "theme:check": "bun run scripts/gen-tokens.ts --check",
    "ui-registry": "bash scripts/ui-registry-probe.sh /tmp/bigface-ui-registry",
    "ui:drift": "bash scripts/ui-drift.sh"
  },
  "dependencies": {
    "cn": "^0.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@shadcn/react": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@shadcn/react": "^0.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "happy-dom": "^21.0.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.60.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vaul": "^1.1.2"
  }
}
