---
import { REPLIES, THREAD } from "../../data/agent-thread.ts";
import { MONO } from "../../data/metrics.ts";
import { renderMarkdown } from "../../lib/markdown.ts";

// The hero's live specimen: an agent conversation rendered entirely in Qu Black. Agent turns are
// markdown — bold verdicts, bullets, fenced code, inline identifiers — and the markdown styling is
// deliberately colourless: a code plate is one greyscale slab in Qu Black Mono, because syntax
// colours would compete with the typeface this page is selling.
const messages = JSON.stringify({ thread: THREAD, replies: REPLIES });

// Every colour below is a theme neutral (foreground / border / background). No accent.
const md =
  "text-[0.84rem] leading-[1.62] [&>*+*]:mt-[0.45rem] " +
  "[&_[data-md-p]]:m-0 " +
  "[&_[data-md-bold]]:font-bold [&_[data-md-bold]]:text-foreground " +
  "[&_[data-md-heading]]:m-0 [&_[data-md-heading]]:font-bold [&_[data-md-heading]]:text-[0.92rem] " +
  "[&_[data-md-inline-code]]:rounded-[4px] [&_[data-md-inline-code]]:bg-muted/25 " +
  "[&_[data-md-inline-code]]:px-[0.3em] [&_[data-md-inline-code]]:py-[0.05em] " +
  "[&_[data-md-inline-code]]:font-mono [&_[data-md-inline-code]]:text-[0.9em] " +
  "[&_[data-md-list]]:my-0 [&_[data-md-list]]:ml-[1.05rem] [&_[data-md-list]]:list-disc [&_[data-md-list]]:p-0 " +
  "[&_pre[data-md-code]]:mt-0 [&_pre[data-md-code]]:mb-0 [&_pre[data-md-code]]:max-w-full " +
  "[&_pre[data-md-code]]:overflow-x-auto " +
  "[&_pre[data-md-code]]:rounded-[9px] [&_pre[data-md-code]]:border [&_pre[data-md-code]]:border-border/80 " +
  "[&_pre[data-md-code]]:bg-background/70 [&_pre[data-md-code]]:px-[0.6rem] [&_pre[data-md-code]]:py-[0.5rem] " +
  "[&_pre[data-md-code]]:font-mono [&_pre[data-md-code]]:text-[0.72rem] [&_pre[data-md-code]]:leading-[1.55] " +
  "[&_pre[data-md-code]]:text-foreground";
---

<div
  id="agent-chat"
  class="flex h-full min-h-0 flex-col overflow-hidden rounded-[22px] border border-border bg-card/80 shadow-[0_24px_60px_-34px_color-mix(in_srgb,var(--card)_95%,transparent)] min-[1180px]:absolute min-[1180px]:inset-0"
  data-agent-chat
  aria-label="Agent conversation specimen"
>
  <div
    class="flex items-center justify-between gap-3 border-b border-border/70 px-[0.9rem] py-[0.65rem]"
  >
    <div class="flex items-center gap-[0.5rem]">
      <span class="relative flex size-[9px] items-center justify-center">
        <span class="absolute size-[9px] rounded-full bg-chart-5/25"></span>
        <span class="size-[5px] rounded-full bg-chart-5"></span>
      </span>
      <span class="font-mono text-[0.72rem] tracking-[0.08em] text-foreground/75 uppercase">
        agent · qublack
      </span>
    </div>
    <span class="font-mono text-[0.66rem] text-foreground/75">
      汉 {MONO.han.toFixed(3)}em / ASCII {MONO.ascii.toFixed(3)}em
    </span>
  </div>

  <!-- A chat thread reads bottom-up: the messages ride the input row, and any spare height the
       stretched card hands the thread pools above the FIRST message (it reads as "scrolled to the
       end"). margin-top: auto on the first bubble does that without justify-end's unreachable
       overflow; the bottom padding matches the inter-message gap so the last bubble sits exactly
       one gap above the form. -->
  <div
    id="agent-thread"
    class="flex max-h-[460px] min-h-0 flex-1 flex-col gap-[0.7rem] overflow-x-hidden overflow-y-auto px-[0.8rem] pt-[0.9rem] pb-[0.7rem] min-[1180px]:max-h-none"
    data-agent-thread
    aria-live="polite"
  >
    {
      THREAD.map((message, index) => (
        <div
          class:list={[
            "min-w-0 max-w-[92%] rounded-[14px] border px-[0.75rem] py-[0.6rem]",
            index === 0 && "mt-auto",
            message.role === "user"
              ? "ml-auto border-border bg-muted/12"
              : "mr-auto border-border bg-card",
          ]}
          data-message={message.role}
        >
          <p class="max-w-[68ch] m-0 mb-[0.3rem] font-mono text-[0.62rem] tracking-[0.06em] text-foreground/75 uppercase">
            {message.meta}
          </p>
          <div class={md} data-message-body set:html={renderMarkdown(message.markdown)} />
        </div>
      ))
    }
  </div>

  <form
    id="agent-form"
    class="flex items-center gap-[0.45rem] border-t border-border/70 px-[0.8rem] py-[0.6rem]"
  >
    <label class="sr-only" for="agent-input">Ask the agent</label>
    <input
      id="agent-input"
      name="message"
      autocomplete="off"
      placeholder="问点什么 — try “fix the 断行”"
      class="min-w-0 flex-1 rounded-full border border-ring/40 bg-background/60 px-[0.75rem] py-[0.46rem] font-mono text-[0.84rem] text-foreground placeholder:text-foreground/75 focus:border-primary focus:outline-none"
    />
    <button
      type="submit"
      class="cursor-pointer rounded-full border border-ring/40 bg-muted/10 px-[0.7rem] py-[0.4rem] font-mono text-[0.72rem] text-foreground/75 transition-colors duration-200 hover:border-primary hover:text-primary"
    >
      send
    </button>
  </form>

  <script type="application/json" id="agent-thread-data" set:html={messages} />
</div>
