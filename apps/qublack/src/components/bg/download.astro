---
import { RELEASE_URL, VERSION, ZIP_NAME } from "../../data/site.ts";
import { BGButton } from "./button.tsx";
import BGCopyButton from "./copy-button.astro";
import BGDownloadCard from "./download-card.astro";

interface Props {
  sha256: string;
}
const { sha256 } = Astro.props;
const installMac = `unzip -o ${ZIP_NAME} -d ~/Library/Fonts/`;
const installLinux = `mkdir -p ~/.local/share/fonts && unzip -o ${ZIP_NAME} -d ~/.local/share/fonts/ && fc-cache -f`;
---

<section id="download" class="scroll-mt-24 py-10 pb-16">
  <div class="mx-auto w-[min(1180px,100%-2.5rem)] max-[760px]:w-[min(1180px,100%-1.75rem)]" data-reveal>
    <div class="mb-[1.6rem] max-w-[62ch]">
      <p class="inline-flex items-center gap-2 font-mono text-[0.72rem] tracking-[0.16em] text-bf-fg-muted uppercase before:size-[6px] before:rounded-full before:bg-bf-blue before:shadow-[0_0_0_4px_color-mix(in_srgb,var(--bf-blue)_16%,transparent)] before:content-['']">
        08 — Download
      </p>
      <h2 class="mt-2 mb-[0.7rem]">Eight faces, one zip</h2>
      <p class="max-w-[56ch] text-[clamp(1.05rem,1.7vw,1.3rem)] text-foreground/75">
        Qu Black Mono and Qu Black Sans, four styles each, plus <code class="font-mono">OFL.txt</code>,
        <code class="font-mono">NOTICE.md</code> and a README. Free for commercial use; redistribution
        keeps the licence.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 min-[900px]:grid-cols-2" data-two-column>
      <div class="grid gap-3">
        <BGDownloadCard href={`${RELEASE_URL}`} label={ZIP_NAME} detail={`release ${VERSION} · TTF + TTC + WOFF2 + OFL + README`} />
        <BGDownloadCard href={`https://github.com/gjuoun/qublack/releases`} label="All releases" detail="tag history, checksums, notes" />
        <BGDownloadCard href="https://github.com/gjuoun/qublack/blob/main/OFL.txt" label="OFL.txt" detail="SIL Open Font License 1.1" />
        <BGDownloadCard href="https://github.com/gjuoun/qublack/blob/main/NOTICE.md" label="NOTICE.md" detail="provenance: Sarasa Gothic + Recursive" />
        <div
          class="rounded-[14px] border border-bf-border bg-bf-border-muted/70 px-4 py-[0.8rem]"
          data-download-formats
        >
          <p class="mb-2 font-mono text-[0.68rem] tracking-[0.12em] text-bf-dim uppercase">
            formats
          </p>
          <ul class="m-0 grid list-none gap-[0.35rem] p-0 text-[0.8rem] text-bf-fg-muted">
            <li>
              <strong class="font-mono text-[0.78rem] text-foreground">TTF</strong> — system install
              (macOS <code class="font-mono">~/Library/Fonts</code>, Windows double-click, Linux
              <code class="font-mono">fc-cache</code>)
            </li>
            <li>
              <strong class="font-mono text-[0.78rem] text-foreground">TTC</strong> —
              <code class="font-mono">QuBlackMono.ttc</code> / <code class="font-mono">QuBlackSans.ttc</code>:
              four faces per file, the smaller bundle
            </li>
            <li>
              <strong class="font-mono text-[0.78rem] text-foreground">WOFF2</strong> —
              <code class="font-mono">@font-face</code> self-hosting; WOFF2 only, no WOFF1 and no OTF
              (the outlines are <code class="font-mono">glyf</code>)
            </li>
          </ul>
        </div>
      </div>

      <div class="flex h-full flex-col rounded-[18px] border border-bf-border bg-bf-border-muted/70 p-[clamp(1rem,2.5vw,1.5rem)]">
        <p class="mb-2 font-mono text-[0.7rem] tracking-[0.12em] text-bf-dim uppercase">Install</p>
        <div class="grid gap-2">
          <div class="flex items-center gap-2 overflow-hidden rounded-[10px] border border-bf-selection bg-bf-border-muted/85 py-2 pr-2 pl-3">
            <span class="font-mono text-[0.68rem] text-bf-dim">macOS</span>
            <code class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.72rem] whitespace-nowrap text-bf-fg">{installMac}</code>
            <BGCopyButton value={installMac} aria-label="Copy the macOS install command" />
          </div>
          <div class="flex items-center gap-2 overflow-hidden rounded-[10px] border border-bf-selection bg-bf-border-muted/85 py-2 pr-2 pl-3">
            <span class="font-mono text-[0.68rem] text-bf-dim">Linux</span>
            <code class="min-w-0 flex-1 overflow-x-auto font-mono text-[0.72rem] whitespace-nowrap text-bf-fg">{installLinux}</code>
            <BGCopyButton value={installLinux} aria-label="Copy the Linux install command" />
          </div>
        </div>
        <p class="mt-4 mb-1 font-mono text-[0.7rem] tracking-[0.12em] text-bf-dim uppercase">sha256</p>
        <code class="block overflow-x-auto font-mono text-[0.68rem] break-all text-bf-fg-muted">{sha256}</code>
        <div class="mt-auto flex flex-wrap gap-2 pt-4">
          <BGButton tone="glow" href={RELEASE_URL}>Download v{VERSION}</BGButton>
          <BGButton tone="ghost" href="https://github.com/gjuoun/qublack">Source</BGButton>
        </div>
      </div>
    </div>
  </div>
</section>
