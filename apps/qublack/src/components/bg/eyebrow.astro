---
// Small mono kicker above a heading, with the blue dot.
interface Props {
  class?: string;
}
const { class: extra = "" } = Astro.props;
---

<p
  class:list={[
    "my-[1em] inline-flex items-center gap-2 font-mono text-[0.72rem] tracking-[0.16em] text-foreground/75 uppercase before:size-[6px] before:rounded-full before:bg-primary before:shadow-[0_0_0_4px_color-mix(in_srgb,var(--primary)_16%,transparent)] before:content-['']",
    extra,
  ]}
>
  <slot />
</p>
