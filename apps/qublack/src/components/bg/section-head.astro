---
import BGEyebrow from "./eyebrow.astro";

// Numbered section heading: kicker, title, lead paragraph.
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="mb-[1.6rem] max-w-[62ch] transition-[opacity,translate] duration-700 [.js_&]:translate-y-4 [.js_&]:opacity-0 [.js_&.in]:translate-y-0 [.js_&.in]:opacity-100" data-reveal>
  <BGEyebrow>{eyebrow}</BGEyebrow>
  <h2 class="mt-2 mb-[0.7rem] text-[clamp(1.7rem,3.2vw,2.4rem)] font-bold leading-[1.08] tracking-[-0.025em] text-balance">{title}</h2>
  <p class="my-[1em] max-w-[56ch] text-[clamp(1.05rem,1.7vw,1.3rem)] text-foreground/75"><slot /></p>
</div>
