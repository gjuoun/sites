---
// The light/dark switch: icon-only, 28px at its smallest, named for screen readers. The mode lives in
// data-mode on <html> and the reader's choice in the theme package's storage key — the same one the
// pre-paint script reads before first paint, so a reload keeps the choice.
---

<button
  type="button"
  id="theme-toggle"
  class="group inline-flex min-h-7 min-w-7 cursor-pointer items-center justify-center border border-border bg-card p-1 text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid focus-visible:outline-foreground"
  aria-label="Dark mode"
  aria-pressed="true"
>
  <span class="inline-flex" aria-hidden="true">
    <svg
      class="hidden group-aria-pressed:inline-block"
      viewBox="0 0 16 16"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="8" cy="8" r="3"></circle>
      <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M13 3l-1 1M4 12l-1 1"></path>
    </svg>
    <svg
      class="inline-block group-aria-pressed:hidden"
      viewBox="0 0 16 16"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"></path>
    </svg>
  </span>
</button>

<script>
  import { MODE_STORAGE_KEY } from "@gjuoun/bigface-business-ui/lib/themes";

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");
  if (button) {
    const sync = () => button.setAttribute("aria-pressed", String(root.dataset.mode === "dark"));
    button.addEventListener("click", () => {
      root.dataset.mode = root.dataset.mode === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(MODE_STORAGE_KEY, root.dataset.mode);
      } catch (error) {
        void error;
      }
      sync();
    });
    sync();
  }
</script>
