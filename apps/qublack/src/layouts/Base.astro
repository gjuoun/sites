---
import "../styles/tailwind.css";
import "../styles/qublack-fonts.css";
import { DEFAULT_THEME, themeInitScript } from "@gjuoun/bigface-business-ui/lib/themes";
import BGSiteFooter from "../components/bg/site-footer.astro";
import BGSiteHeader from "../components/bg/site-header.astro";
import BGAtmosphere from "../components/bg/atmosphere.astro";
import BGToast from "../components/bg/toast.astro";
import { REPO } from "../data/site.ts";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "黢黑 Qu Black — a bilingual programming font family with a strict 2:1 grid.",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const origin = Astro.site ? new URL(Astro.site).origin : "";

---

<!doctype html>
<html
  lang="en"
  data-theme={DEFAULT_THEME}
  data-mode="dark"
  class="[font-variant-ligatures:none] bg-background text-foreground font-sans text-[16px] leading-[1.65] [-webkit-text-size-adjust:100%] [scroll-behavior:smooth] [font-variation-settings:'MONO'_0,'CASL'_0,'slnt'_0,'CRSV'_0.5] motion-reduce:[scroll-behavior:auto] motion-reduce:[&_*]:[animation-duration:0.001ms]! motion-reduce:[&_*]:[animation-iteration-count:1]! motion-reduce:[&_*]:[transition-duration:0.001ms]!"
>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline set:html={themeInitScript}></script>
    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${origin}${base}/`} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={`${origin}${base}/`} />
    <link rel="preload" href={`${base}/fonts/QuBlackSans-Regular.0.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/QuBlackMono-Regular.0.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body
    class="m-0 flex min-h-screen flex-col relative isolate overflow-x-hidden bg-transparent text-foreground [&_img]:inline [&_img]:align-baseline [&_svg]:inline [&_svg]:align-baseline [&_video]:inline [&_video]:align-baseline [&_canvas]:inline [&_canvas]:align-baseline [&_button]:leading-normal [&_input]:leading-normal [&_select]:leading-normal [&_textarea]:leading-normal"
  >
    <BGAtmosphere />
    <BGSiteHeader base={base} repo={REPO} />
    <main
      id="main"
      class="mx-auto w-[min(1180px,100%-2.5rem)] max-[760px]:w-[min(1180px,100%-1.75rem)] flex-1 pt-10 pb-24 max-[760px]:pt-6"
    ><slot /></main>
    <BGSiteFooter base={base} repo={REPO} />
    <BGToast />

    <script>
      const toast = document.getElementById("toast");
      let toastTimer: number | undefined;
      const say = (message: string) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("show"), 1900);
      };

      document.addEventListener("click", async (event) => {
        const trigger = (event.target as HTMLElement | null)?.closest?.<HTMLElement>("[data-copy]");
        if (!trigger) return;
        event.preventDefault();
        const value = trigger.getAttribute("data-copy") ?? "";
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const box = document.createElement("textarea");
          box.value = value;
          document.body.append(box);
          box.select();
          document.execCommand("copy");
          box.remove();
        }
        trigger.classList.add("done");
        say(`copied ${value.length > 44 ? `${value.slice(0, 44)}…` : value}`);
        window.setTimeout(() => trigger.classList.remove("done"), 1500);
      });

      const header = document.getElementById("site-header");
      const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });

      const revealables = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        for (const element of revealables) io.observe(element);
      } else {
        for (const element of revealables) element.classList.add("in");
      }
    </script>
    <script>
      import "../scripts/specimen-client.ts";
      import "../scripts/agent-chat.ts";
    </script>
  </body>
</html>
