---
import { PAGE } from '@/lib/layout';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const links = [
  { href: base + '/#features', label: 'Features' },
  { href: base + '/#how', label: 'How it works' },
  { href: base + '/#commands', label: 'Commands' },
  { href: base + '/docs/', label: 'Docs' },
];
---

<div class="border-t border-border/60 py-3 pb-4">
  <p class="mb-1.5 px-3 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground">Site</p>
  <nav class="grid gap-0.5" aria-label="Site">
    {links.map((link) => (
      <a
        href={link.href}
        class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-muted-foreground no-underline hover:bg-muted hover:text-foreground"
      >
        {link.label}
      </a>
    ))}
    <a
      href="https://github.com/gjuoun/bundant"
      target="_blank"
      rel="noreferrer"
      class="flex min-h-11 items-center rounded-md px-3 text-sm font-medium text-muted-foreground no-underline hover:bg-muted hover:text-foreground"
    >
      GitHub
    </a>
  </nav>
</div>
