---
import Search from '@astrojs/starlight/components/Search.astro';
import { asset } from "@/lib/assets";
import { BGThemeToggle } from '@sites/bigface/components/bg/theme-toggle';
import { PAGE } from '@/lib/layout';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const links = [
  { href: base + '/#features', label: 'Features' },
  { href: base + '/#how', label: 'How it works' },
  { href: base + '/#commands', label: 'Commands' },
  { href: base + '/docs/', label: 'Docs' },
];
---

<div class="h-full">
  <div class={`${PAGE} flex h-full items-center gap-4`}>
    <a href={base + '/'} class="flex min-w-0 items-center gap-2.5 text-foreground no-underline" aria-label="bundant home">
      <span class="block size-8 shrink-0 overflow-hidden rounded-[4px]" aria-hidden="true">
        <img
          src={asset("img/content-bear.png")}
          alt=""
          width="32"
          height="32"
          class="block size-full object-cover [transform:scale(1.35)] [transform-origin:72%_50%]"
        />
      </span>
      <span class="text-[0.9375rem] font-semibold tracking-tight text-foreground">bundant</span>
      <span class="hidden rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground sm:inline">0.1.0</span>
    </a>

    <nav class="ms-2 hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class="inline-flex h-11 items-center rounded-md px-3 text-[0.8125rem] font-medium whitespace-nowrap text-muted-foreground no-underline hover:bg-muted hover:text-foreground"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ms-auto flex min-w-0 items-center gap-2 md:shrink-0">
      <div class="flex min-w-0 [&>site-search]:contents"><Search /></div>
      <BGThemeToggle client:load />
      <button
        type="button"
        class="group inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border bg-card p-0 text-foreground hover:bg-muted aria-expanded:border-primary aria-expanded:text-primary md:hidden"
        data-bf-menu
        aria-label="Menu"
        aria-controls="starlight__sidebar"
        aria-expanded="false"
      >
        <svg class="group-aria-expanded:hidden" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden group-aria-expanded:inline" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
      <a
        href="https://github.com/gjuoun/bundant"
        target="_blank"
        rel="noreferrer"
        class="hidden h-11 items-center gap-2 rounded-lg border border-border px-3 text-[0.8125rem] font-medium text-muted-foreground no-underline hover:bg-muted hover:text-foreground sm:inline-flex"
        aria-label="bundant on GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</div>

<script>
  const local = document.querySelector<HTMLButtonElement>('[data-bf-menu]');
  const host = document.querySelector('starlight-menu-button');
  const trigger = host?.querySelector<HTMLButtonElement>('button');

  if (local && host && trigger) {
    const sync = () => {
      local.setAttribute('aria-expanded', host.getAttribute('aria-expanded') === 'true' ? 'true' : 'false');
    };

    local.addEventListener('click', () => {
      trigger.click();
      requestAnimationFrame(sync);
    });

    new MutationObserver(sync).observe(host, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && host.getAttribute('aria-expanded') === 'true') {
        trigger.click();
      }
    });
  }
</script>
