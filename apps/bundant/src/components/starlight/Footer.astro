---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { withBase } from '@/lib/utils';

const year = new Date().getFullYear();
---

<footer class="mt-12">
  <Pagination />

  <div class="mt-8 flex flex-col gap-4 border-t border-border pb-2 pt-7 text-[0.8125rem] text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2.5">
      <span class="grid size-6 place-items-center rounded bg-primary font-mono text-xs font-bold text-primary-foreground">b</span>
      <span>bundant — zero-downtime single-host deploys.</span>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a href={withBase('docs/')} class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-foreground sm:min-h-0">Docs</a>
      <a href="https://github.com/gjuoun/bundant" class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-foreground sm:min-h-0">GitHub</a>
      <a href="https://github.com/gjuoun/bigface-theme" class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-foreground sm:min-h-0">Theme</a>
      <a href="https://github.com/gjuoun/bundant/blob/main/LICENSE" class="inline-flex min-h-11 items-center text-muted-foreground no-underline hover:text-foreground sm:min-h-0">MIT License</a>
      <span class="font-mono text-[11px]">{year}</span>
    </div>
  </div>
</footer>
