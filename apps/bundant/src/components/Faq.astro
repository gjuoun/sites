---
import { FaqList } from '@/components/FaqList';
import { LABEL, PAGE } from '@/lib/layout';
---

<section id="faq" class="border-b border-border py-16 md:py-24">
  <div class={PAGE}>
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class={LABEL}>FAQ</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          The questions before the first deploy.
        </h2>
        <p class="mt-4 max-w-md text-muted-foreground">
          If something is not shipped, it is not promised here. The CLI help is the
          source of truth.
        </p>
      </div>
      <FaqList client:load />
    </div>
  </div>
</section>
