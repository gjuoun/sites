---
import { MODE_STORAGE_KEY, MODES } from "@gjuoun/bigface-business-ui/lib/themes";

// The only client JavaScript on the site: it renders static HTML and one constant inline
// script. The state lives in data-mode on <html> — the package's pre-paint script reads the
// same storage key — so this component writes it through the same contract. Icon-only, 28px
// at its smallest, named for screen readers.
const script = `(() => {
	const root = document.documentElement;
	const button = document.getElementById("theme-toggle");
	if (!button) return;
	const KEY = ${JSON.stringify(MODE_STORAGE_KEY)};
	const MODES = ${JSON.stringify([...MODES])};
	const apply = (mode) => {
		root.dataset.mode = mode;
		root.style.colorScheme = mode;
		button.setAttribute("aria-pressed", String(mode === "dark"));
		const meta = document.querySelector('meta[name="theme-color"]');
		if (meta) {
			meta.setAttribute(
				"content",
				getComputedStyle(root).getPropertyValue("--theme-bg").trim(),
			);
		}
		const sun = button.querySelector('[data-icon="sun"]');
		const moon = button.querySelector('[data-icon="moon"]');
		if (sun) sun.classList.toggle("hidden", mode !== "dark");
		if (moon) moon.classList.toggle("hidden", mode === "dark");
	};
	// color-scheme has to be inline: light-dark() resolves on it, and the package's pre-paint
	// script only writes data-mode.
	apply(MODES.includes(root.dataset.mode) ? root.dataset.mode : "dark");
	button.addEventListener("click", () => {
		const next = root.dataset.mode === "dark" ? "light" : "dark";
		try {
			localStorage.setItem(KEY, next);
		} catch (e) {
			/* storage blocked: the mode still flips for this page view */
		}
		apply(next);
	});
})();`;
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex min-h-7 min-w-7 cursor-pointer items-center justify-center rounded-md border border-border bg-card p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid focus-visible:outline-foreground"
  aria-label="Dark mode"
  aria-pressed="true"
>
  <span class="inline-flex" aria-hidden="true">
    <svg data-icon="sun" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="8" cy="8" r="3"></circle>
      <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M13 3l-1 1M4 12l-1 1"></path>
    </svg>
    <svg data-icon="moon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden">
      <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z"></path>
    </svg>
  </span>
</button>

<script is:inline set:html={script}></script>
