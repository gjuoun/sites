{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "scripts",
    "data"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
