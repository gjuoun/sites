---
import { BGBadge } from "@gjuoun/bigface-ui/components/bg/badge";
import type { Target } from "../../data/targets.ts";
import BGEyebrow from "./eyebrow.astro";

// App page header: kind and port number, the name, the tagline, and how far the theme was checked.
interface Props {
  target: Target;
  index: number;
  total: number;
  levelLabel: string;
}
const { target, index, total, levelLabel } = Astro.props;
---

<header class="pt-6 pb-2" data-reveal>
  <div>
    <BGEyebrow>{target.kind} · port {String(index + 1).padStart(2, "0")} of {total}</BGEyebrow>
    <h1 class="text-[clamp(2.3rem,5.2vw,3.6rem)] font-extrabold">
      <span class="bf-grad">Bigface for {target.name}</span>
    </h1>
    <p class="bf-lead">{target.tagline}</p>
    <div class="mt-4 flex flex-wrap gap-[0.45rem]">
      <BGBadge tone={target.check.level}>{levelLabel}</BGBadge>
      <BGBadge tone="pill">{target.files.length} file{target.files.length === 1 ? "" : "s"}</BGBadge>
    </div>
  </div>
</header>
