---
import { bgCardVariants } from "./card.tsx";
import { BGButton } from "./button.tsx";
import { cn } from "@gjuoun/bigface-business-ui/lib/utils";
import BGEyebrow from "./eyebrow.astro";

// "Published" strip for targets that ship through their app's own gallery.
interface Props {
  label: string;
  url: string;
  name: string;
}
const { label, url, name } = Astro.props;
---

<section
  class={cn(
    bgCardVariants({ tone: "plate" }),
    "mt-[1.6rem] flex flex-wrap items-center justify-between gap-4 px-[1.2rem] py-4",
  )}
  data-reveal
>
  <div class="flex flex-col gap-[0.15rem]">
    <BGEyebrow class="mb-1">published</BGEyebrow>
    <strong class="font-display text-[1.1rem]">{label}</strong>
    <span class="text-muted-foreground">{name} installs and updates it from its own gallery.</span>
  </div>
  <BGButton tone="glow" href={url}>Open listing <span aria-hidden="true">↗</span></BGButton>
</section>
