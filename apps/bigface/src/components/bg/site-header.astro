---
import { BGButton } from "./button.tsx";

// Site header: skip link, brand, main nav. Sits on the page background at rest; the scroll script in
// Base.astro adds .scrolled once the page moves, which gives it a hairline and a surface. Below 520px
// the brand keeps only its mark (the name stays for screen readers) and the links tighten, so all four
// fit a 390px screen.
interface Props {
  base: string;
  repo: string;
}
const { base, repo } = Astro.props;
const link =
  "rounded-lg px-3 py-[0.4rem] text-muted-foreground no-underline transition-[color,background] duration-200 hover:bg-border/10 hover:text-foreground max-[520px]:px-2";
---

<a
  class="absolute -left-[9999px] focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
  href="#main">Skip to content</a
>
<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-transparent transition-[border-color,background] duration-300 ease-bf [&.scrolled]:border-border [&.scrolled]:bg-border/92 [&.scrolled]:backdrop-blur-[18px] [&.scrolled]:backdrop-saturate-150"
>
  <div
    class="mx-auto flex w-[min(1180px,100%-2.5rem)] items-center justify-between gap-4 py-[0.85rem] max-[760px]:w-[min(1180px,100%-1.75rem)]"
  >
    <a
      class="group inline-flex items-center gap-[0.65rem] font-display text-[1.1rem] font-bold tracking-[-0.01em] text-foreground no-underline hover:text-foreground"
      href={`${base}/`}
    >
      <img
        class="size-[34px] rounded-[9px] shadow-[0_0_0_1px_var(--border),0_6px_18px_color-mix(in_srgb,var(--primary)_35%,transparent)] transition-transform duration-400 ease-bf group-hover:scale-[1.06] group-hover:-rotate-6"
        src={`${base}/img/bigface-avatar.svg`}
        alt=""
        width="34"
        height="34"
      />
      <span class="max-[520px]:sr-only">Bigface</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-[0.4rem] text-[0.9rem] max-[520px]:gap-[0.15rem]">
      <a class={link} href={`${base}/#apps`}>Apps</a>
      <a class={link} href={`${base}/palette/`}>Palette</a>
      <a class={link} href={`${base}/#install`}>Install</a>
      <BGButton tone="nav" href={repo} className="max-[520px]:px-2">GitHub</BGButton>
    </nav>
  </div>
</header>
