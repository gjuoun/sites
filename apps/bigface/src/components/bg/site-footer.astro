---
// Site footer: the mark with a one-line pitch, and the footer nav.
interface Props {
  base: string;
  repo: string;
  ports: number;
}
const { base, repo, ports } = Astro.props;
const link = "text-bf-blue no-underline transition-colors duration-200 hover:text-bf-lime";
---

<footer
  class="border-t border-bf-border bg-linear-to-b/srgb from-bf-border/20 to-bf-border/85"
>
  <div
    class="mx-auto flex w-[min(1180px,100%-2.5rem)] flex-wrap items-start justify-between gap-8 pt-10 pb-12"
  >
    <div>
      <div class="flex items-center gap-[0.7rem] font-display font-bold">
        <img
          class="size-10 rounded-[11px] shadow-[0_0_0_1px_var(--bf-highlight)]"
          src={`${base}/img/bigface-avatar.svg`}
          alt=""
          width="40"
          height="40"
        />
        Bigface
      </div>
      <p class="mt-[0.6rem] mb-0 max-w-[34ch] text-[0.85rem] text-bf-dim">
        One dark palette, {ports} ports, no per-tool adjustments. Started in 2018 as a JetBrains scheme.
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-[0.6rem] text-[0.88rem]">
      <a class={link} href={`${base}/#apps`}>Apps</a>
      <a class={link} href={`${base}/palette/`}>Palette</a>
      <a class={link} href={`${base}/#install`}>Install</a>
      <a class={link} href={`${base}/install.sh`}>install.sh</a>
      <a class={link} href={repo}>GitHub</a>
      <a class={link} href={`${repo}/blob/main/LICENSE`}>MIT licence</a>
    </nav>
  </div>
</footer>
