---
import { BGBadge } from "@gjuoun/bigface-ui/components/bg/badge";
import { BGButton } from "@gjuoun/bigface-ui/components/bg/button";
import { BGCard } from "@gjuoun/bigface-ui/components/bg/card";
import { BGInstallTabs } from "@gjuoun/bigface-ui/components/bg/install-tabs";
import { Badge } from "@gjuoun/bigface-ui/components/ui/badge";
import { Button } from "@gjuoun/bigface-ui/components/ui/button";
import { Download } from "lucide-react";
import badgeSrc from "../../../../../packages/ui/src/components/ui/badge.tsx?raw";
import buttonSrc from "../../../../../packages/ui/src/components/ui/button.tsx?raw";
import tabsSrc from "../../../../../packages/ui/src/components/ui/tabs.tsx?raw";
import BGAppCard from "../../components/bg/app-card.astro";
import BGBreadcrumbs from "../../components/bg/breadcrumbs.astro";
import BGCodeCard from "../../components/bg/code-card.astro";
import BGCommandLine from "../../components/bg/command-line.astro";
import BGContrastTable from "../../components/bg/contrast-table.astro";
import BGCopyButton from "../../components/bg/copy-button.astro";
import BGDivider from "../../components/bg/divider.astro";
import BGDownloadCard from "../../components/bg/download-card.astro";
import BGEyebrow from "../../components/bg/eyebrow.astro";
import BGFilterChips from "../../components/bg/filter-chips.astro";
import BGManualSteps from "../../components/bg/manual-steps.astro";
import BGMarketCard from "../../components/bg/market-card.astro";
import BGMarquee from "../../components/bg/marquee.astro";
import BGNextCard from "../../components/bg/next-card.astro";
import { bgTextClass } from "../../components/bg/palette-classes.ts";
import BGPaletteGroup from "../../components/bg/palette-group.astro";
import BGSectionHead from "../../components/bg/section-head.astro";
import BGSplit from "../../components/bg/split.astro";
import BGStat from "../../components/bg/stat.astro";
import BGSwatch from "../../components/bg/swatch.astro";
import BGSwatchChip from "../../components/bg/swatch-chip.astro";
import BGSyntaxPreview from "../../components/bg/syntax-preview.astro";
import { palette } from "../../data/palette.ts";
import { installCommand, targets } from "../../data/targets.ts";
import { bgCatalog, textScale, variantKeys } from "../../data/ui-catalog.ts";
import Base from "../../layouts/Base.astro";
import tailwindCss from "../../styles/tailwind.css?raw";
import BGEntry from "./_bg-entry.astro";
import { CardDemo, TabsDemo } from "./_demos.tsx";

// The component library the site is built from, rendered live. Lists that can be read from source
// are: the semantic tokens (tailwind.css :root), the font stacks (@theme), the text scale (every
// font-size class used under src/).
const sources = Object.values(
  import.meta.glob(
    [
      "../../components/**/*.astro",
      "../../../../../packages/ui/src/components/**/*.tsx",
      "../**/*.astro",
    ],
    {
      query: "?raw",
      import: "default",
      eager: true,
    },
  ),
) as string[];
const scale = textScale(sources);

const rootBlock = /:root \{([\s\S]*?)\n\}/.exec(tailwindCss)?.[1] ?? "";
const tokens = [...rootBlock.matchAll(/--([\w-]+):\s*var\(--([\w-]+)\);/g)].map((m) => ({
  token: m[1] as string,
  source: m[2] as string,
}));
const font = (name: string) =>
  new RegExp(`--font-${name}:\\s*([^;]+);`).exec(tailwindCss)?.[1]?.trim() ?? "";
const fonts = [
  {
    cls: "font-display",
    label: "Display",
    stack: font("display"),
    use: "headings, the brand, stats",
  },
  { cls: "font-sans", label: "Sans", stack: font("sans"), use: "body copy and controls" },
  {
    cls: "font-code",
    label: "Mono",
    stack: `${font("mono")} + "MONO" 1 axis`,
    use: "code, commands, kickers, chips",
  },
];
const ansiRows = Object.entries(palette.ansi);
const swatches = "grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-[0.7rem]";
const subLink =
  "rounded-full px-[0.7rem] py-[0.3rem] text-bf-fg-muted hover:bg-bf-border/10 hover:text-foreground";
const sections = [
  ["tokens", "Colour"],
  ["type", "Type"],
  ["native", "Native"],
  ["bg", "BG"],
  ["missing", "Not yet"],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bgSources = Object.fromEntries(
  Object.entries(
    import.meta.glob(
      ["../../components/bg/*.{astro,ts}", "../../../../../packages/ui/src/components/bg/*.tsx"],
      {
        query: "?raw",
        import: "default",
        eager: true,
      },
    ),
  ).map(([path, src]) => [path.split("/").pop() as string, src as string]),
);
const notFinal = bgCatalog.filter((e) => !e.finalised);
const pi = targets.find((t) => t.id === "pi") ?? (targets[0] as (typeof targets)[number]);
const market = targets.find((t) => t.market);
const kinds = [...new Set(targets.map((t) => t.kind))];
// Variant and size keys come from the shadcn sources, so a variant added upstream shows up here.
const buttonVariants = variantKeys(buttonSrc, "variant") as ButtonVariant[];
const buttonSizes = variantKeys(buttonSrc, "size") as ButtonSize[];
const badgeVariants = variantKeys(badgeSrc, "variant") as BadgeVariant[];
const tabsVariants = variantKeys(tabsSrc, "variant") as ("default" | "line")[];
type ButtonVariant = NonNullable<Parameters<typeof Button>[0]["variant"]>;
type ButtonSize = NonNullable<Parameters<typeof Button>[0]["size"]>;
type BadgeVariant = NonNullable<Parameters<typeof Badge>[0]["variant"]>;
const entry = "mt-[1.4rem] min-w-0 p-5 md:p-6";
const matrix = "max-w-full overflow-x-auto rounded-[14px] border border-bf-border-muted p-3";

// The whole native set, read from the directory itself: the list can never fall behind
// components/ui. Exports come from each file's own export statement, variants from its cva.
const nativeSet = Object.entries(
  import.meta.glob("../../../../../packages/ui/src/components/ui/*.tsx", {
    query: "?raw",
    import: "default",
    eager: true,
  }),
)
  .map(([path, raw]) => {
    const name = (path.split("/").pop() as string).replace(/\.tsx$/, "");
    const src = raw as string;
    const block = /export\s*\{([\s\S]*?)\}/.exec(src)?.[1] ?? "";
    const parts = block
      ? block
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean)
      : [...src.matchAll(/export\s+(?:function|const|class|type|interface)\s+(\w+)/g)].map(
          (m) => m[1] as string,
        );
    return {
      name,
      parts,
      variants: variantKeys(src, "variant"),
      sizes: variantKeys(src, "size"),
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
const nativeFeatured = new Set(["button", "badge", "card", "tabs"]);
const nativeRest = nativeSet.filter((e) => !nativeFeatured.has(e.name));
const cellLabel = "font-code text-[0.7rem] text-bf-dim";
---

<Base
  chrome={false}
  bleed
  noindex
  title="Bigface UI — component workspace"
  description="The internal Bigface component workspace: every colour, font and component, rendered live."
>
  <div class="px-[clamp(1rem,4vw,2.5rem)] pt-[clamp(0.75rem,3vw,1.5rem)] pb-20">
  <section data-reveal>
    <BGEyebrow>component library · work in progress</BGEyebrow>
    <h1 class="text-[clamp(2.6rem,6vw,4.4rem)] leading-[1.02] font-extrabold">
      Bigface <span class="bf-grad">UI</span>
    </h1>
    <p class="bf-lead">
      The internal workspace where this library is built and iterated: every colour, font and
      component below is the production one, rendered live. Unlisted — reachable by URL only.
    </p>
  </section>

  <nav
    class="sticky top-0 z-20 mt-[1.6rem] flex flex-wrap gap-[0.35rem] rounded-[16px] border border-bf-border bg-bf-border-muted/82 p-[0.55rem] text-[0.8rem] backdrop-blur-[14px] max-[700px]:static"
    aria-label="Library sections"
  >
    {sections.map(([id, title]) => <a class={subLink} href={`#${id}`}>{title}</a>)}
  </nav>

  <section id="tokens" class="mt-[2.8rem]">
    <BGSectionHead eyebrow="01 — colour" title="Colour tokens">
      The 20 palette colours, each with where it comes from and the contrast its ink reaches. The 16
      ANSI slots are aliases of those, never new colours.
    </BGSectionHead>
    <div class={swatches}>
      {Object.entries(palette.colors).map(([n, c]) => <BGSwatch name={n} color={c} />)}
    </div>

    <h3 class="flex items-baseline gap-[0.6rem]">
      Terminal (ANSI) <BGBadge tone="pill">aliases</BGBadge>
    </h3>
    <div class={swatches}>
      {ansiRows.map(([n, c]) => <BGSwatch name={n} color={c} />)}
    </div>

    <h3>Semantic tokens</h3>
    <p class="text-bf-fg-muted">
      What shadcn's components paint with, read from <code>tailwind.css</code>. Each one is a palette
      variable and nothing else.
    </p>
    <div class="max-w-full overflow-x-auto">
      <table class="max-w-[640px]">
        <thead>
          <tr><th>Token</th><th>Palette</th></tr>
        </thead>
        <tbody>
          {
            tokens.map((t) => (
              <tr>
                <td class="font-code text-[0.8rem] text-bf-fg-muted">--{t.token}</td>
                <td>
                  <i
                    class="mr-[0.3rem] inline-block size-[0.8em] rounded-[3px] border border-bf-border bg-(--c) align-[-0.06em]"
                    style={`--c:var(--${t.source})`}
                  />{" "}
                  <code>{t.source}</code>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <BGDivider />

  <section id="type">
    <BGSectionHead eyebrow="02 — type" title="Type">
      One family, Recursive, loaded once. The display and sans stacks differ only in fallbacks; the
      mono face is the same file with the MONO axis on.
    </BGSectionHead>
    <div class="grid gap-[0.9rem] md:grid-cols-3">
      {
        fonts.map((f) => (
          <BGCard tone="plate" className="min-w-0 p-5">
            <div class="flex items-baseline justify-between gap-2">
              <strong class="font-display">{f.label}</strong>
              <code>{f.cls}</code>
            </div>
            <p class:list={[f.cls, "my-3 text-[1.9rem] leading-[1.2] break-words"]}>
              Bigface 2018 {"{ }"} 0123
            </p>
            <p class="m-0 font-code text-[0.7rem] break-words text-bf-dim">{f.stack}</p>
            <p class="mt-1 mb-0 text-[0.82rem] text-bf-fg-muted">{f.use}</p>
          </BGCard>
        ))
      }
    </div>

    <h3>Scale in use</h3>
    <p class="text-bf-fg-muted">
      Every font-size class used under <code>site/src/</code>, smallest first, each line set in its own
      size. Headings without a class use the element defaults: <code>h1</code>
      <code>clamp(2.6rem, 6vw, 4rem)</code>, <code>h2</code> <code>clamp(1.7rem, 3.2vw, 2.4rem)</code>,
      <code>h3</code> <code>1.1rem</code>.
    </p>
    <BGCard tone="plate" className="overflow-hidden p-0">
      {
        scale.map((c) => (
          <div class="flex min-w-0 flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-bf-border-muted px-5 py-3 last:border-b-0">
            <span class:list={[c, "min-w-0 leading-[1.2] break-words"]}>Bigface palette</span>
            <code class="shrink-0">{c}</code>
          </div>
        ))
      }
    </BGCard>
  </section>
  <BGDivider />

  <section id="native">
    <BGSectionHead eyebrow="03 — native" title="Native components">
      Everything in <code>components/ui/</code>, exactly as the shadcn CLI wrote it — all
      {nativeSet.length} components the registry ships. The four below are documented in depth;
      the rest follow with their exports and the variant keys read from their own source.
    </BGSectionHead>

    <BGCard tone="plate" className={entry} data-native="button">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="m-0">Button</h3>
        <BGBadge tone="pill">native · shadcn</BGBadge>
      </div>
      <BGCodeCard path="import" code={'import { Button } from "@gjuoun/bigface-ui/components/ui/button";'} truncated={false} />
      <p class="mb-2 text-bf-fg-muted">Every variant × size. Icon sizes carry an icon instead of a label.</p>
      <div class={matrix}>
        <table class="w-max min-w-full">
          <thead>
            <tr>
              <th></th>
              {buttonSizes.map((size) => <th>{size}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              buttonVariants.map((variant) => (
                <tr>
                  <td class={cellLabel}>{variant}</td>
                  {buttonSizes.map((size) => (
                    <td>
                      {size.startsWith("icon") ? (
                        <Button variant={variant} size={size} aria-label={`${variant} ${size}`}>
                          <Download />
                        </Button>
                      ) : (
                        <Button variant={variant} size={size}>
                          Button
                        </Button>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 mb-2 text-bf-fg-muted">
        States per variant. Hover and focus are live: point at or tab to any button above.
      </p>
      <div class={matrix}>
        <table class="w-max min-w-full">
          <thead>
            <tr><th></th><th>default</th><th>disabled</th><th>aria-invalid</th></tr>
          </thead>
          <tbody>
            {
              buttonVariants.map((variant) => (
                <tr>
                  <td class={cellLabel}>{variant}</td>
                  <td><Button variant={variant}>Default</Button></td>
                  <td><Button variant={variant} disabled>Disabled</Button></td>
                  <td><Button variant={variant} aria-invalid="true">Invalid</Button></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </BGCard>

    <BGCard tone="plate" className={entry} data-native="badge">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="m-0">Badge</h3>
        <BGBadge tone="pill">native · shadcn</BGBadge>
      </div>
      <BGCodeCard path="import" code={'import { Badge } from "@gjuoun/bigface-ui/components/ui/badge";'} truncated={false} />
      <p class="mb-2 text-bf-fg-muted">Every variant; Badge has no size. Not interactive, so no hover or disabled state.</p>
      <div class={matrix}>
        <div class="flex flex-wrap items-center gap-4">
          {
            badgeVariants.map((variant) => (
              <span class="inline-flex flex-col items-start gap-1">
                <Badge variant={variant}>{variant}</Badge>
                <span class={cellLabel}>{variant}</span>
              </span>
            ))
          }
        </div>
      </div>
    </BGCard>

    <BGCard tone="plate" className={entry} data-native="card">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="m-0">Card</h3>
        <BGBadge tone="pill">native · shadcn</BGBadge>
      </div>
      <BGCodeCard
        path="import"
        code={'import {\n  Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle,\n} from "@gjuoun/bigface-ui/components/ui/card";'}
        truncated={false}
      />
      <p class="mb-2 text-bf-fg-muted">Both sizes with every slot filled. Static, so no states.</p>
      <div class:list={[matrix, "grid gap-4 md:grid-cols-2"]}>
        <CardDemo size="default" />
        <CardDemo size="sm" />
      </div>
    </BGCard>

    <BGCard tone="plate" className={entry} data-native="tabs">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="m-0">Tabs</h3>
        <BGBadge tone="pill">native · shadcn</BGBadge>
      </div>
      <BGCodeCard
        path="import"
        code={'import { Tabs, TabsContent, TabsList, TabsTrigger } from "@gjuoun/bigface-ui/components/ui/tabs";'}
        truncated={false}
      />
      <p class="mb-2 text-bf-fg-muted">
        Every list variant × orientation, live (one island each). The third trigger is disabled; focus
        and arrow keys work.
      </p>
      <div class:list={[matrix, "grid gap-6 md:grid-cols-2"]}>
        {
          tabsVariants.flatMap((variant) =>
            (["horizontal", "vertical"] as const).map((orientation) => (
              <div class="min-w-0">
                <p class:list={[cellLabel, "mt-0 mb-2"]}>variant={variant} · {orientation}</p>
                <TabsDemo client:load variant={variant} orientation={orientation} />
              </div>
            )),
          )
        }
      </div>
    </BGCard>

    <BGCard tone="plate" className={entry}>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="m-0">The full set — {nativeSet.length} components</h3>
        <BGBadge tone="pill">native · shadcn</BGBadge>
      </div>
      <p class="mb-2 text-bf-fg-muted">
        Every component the CLI ships, installed and upgrade-clean (<code>ui:drift</code>). The four
        above are documented in depth; the rest are registered with how many parts each exports and
        the variant keys its own source declares.
      </p>
      <div class="grid gap-4 md:grid-cols-2">
        {
          nativeRest.map((c) => (
            <div
              class="min-w-0 rounded-[14px] border border-bf-border-muted p-4"
              data-native={c.name}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="m-0 font-code text-[0.9rem]">{c.name}</h4>
                <span class="font-code text-[0.7rem] text-bf-dim">
                  {c.parts.length} exports
                </span>
              </div>
              {c.variants.length > 0 && (
                <p class="mt-2 mb-0 text-[0.82rem] text-bf-fg-muted">
                  <code>variant</code>: {c.variants.join(" · ")}
                </p>
              )}
              {c.sizes.length > 0 && (
                <p class="mt-1 mb-0 text-[0.82rem] text-bf-fg-muted">
                  <code>size</code>: {c.sizes.join(" · ")}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </BGCard>
  </section>

  <BGDivider />

  <section id="bg">
    <BGSectionHead eyebrow="04 — bg" title="BG components">
      Everything in <code>components/bg/</code>: the Bigface layer. Wrappers add variants over a
      native component without touching it; composite blocks are built from utilities and other BG
      parts. Props are shown straight from each file.
    </BGSectionHead>
    <p class="text-bf-fg-muted">
      {`${bgCatalog.length} entries · ${bgCatalog.filter((e) => e.kind === "wrapper").length} wrappers · ${notFinal.length} with props not finalised.`}
    </p>

    {
      bgCatalog.map((entry) => (
        <BGEntry entry={entry} source={bgSources[entry.file] ?? ""} base={base}>
          {entry.name === "BGButton" && (
            <div class="flex flex-wrap items-center gap-3">
              <BGButton tone="glow">glow</BGButton>
              <BGButton tone="ghost">ghost</BGButton>
              <BGButton tone="copy">copy</BGButton>
              <BGButton tone="nav" href="#bg-BGButton">nav (href)</BGButton>
              <BGButton tone="chip" aria-pressed="false">chip</BGButton>
              <BGButton tone="chip" aria-pressed="true">chip pressed</BGButton>
              <BGButton tone="ghost" disabled>ghost disabled</BGButton>
            </div>
          )}
          {entry.name === "BGBadge" && (
            <div class="flex flex-wrap items-center gap-3">
              <BGBadge tone="pill">pill</BGBadge>
              <BGBadge tone="tool">tool</BGBadge>
              <BGBadge tone="schema">schema</BGBadge>
              <BGBadge tone="format">format</BGBadge>
            </div>
          )}
          {entry.name === "BGCard" && (
            <div class="grid gap-4 md:grid-cols-2">
              <BGCard tone="plate" className="p-5">tone="plate"</BGCard>
              <BGCard tone="plate" glow className="p-5">tone="plate" glow</BGCard>
            </div>
          )}
          {entry.name === "BGInstallTabs" && (
            <BGInstallTabs
              client:load
              items={[
                { id: "demo-install", label: "Install", bar: "sh — install", command: installCommand("pi"), note: "With a terminal bar (home)." },
                { id: "demo-off", label: "Uninstall", command: installCommand("--uninstall pi"), note: "Without one (app pages)." },
              ]}
            />
          )}
          {entry.name === "BGEyebrow" && <BGEyebrow>a kicker</BGEyebrow>}
          {entry.name === "BGSectionHead" && (
            <BGSectionHead eyebrow="00 — demo" title="A section heading">
              The lead paragraph sits under it.
            </BGSectionHead>
          )}
          {entry.name === "BGDivider" && <BGDivider />}
          {entry.name === "BGCopyButton" && <BGCopyButton value={palette.colors.blue?.hex ?? ""} aria-label="Copy the blue hex" />}
          {entry.name === "BGCommandLine" && <BGCommandLine command={installCommand()} />}
          {entry.name === "BGStat" && (
            <div class="grid max-w-sm grid-cols-2 gap-px overflow-hidden rounded-[16px] border border-bf-border bg-bf-border">
              <BGStat value={targets.length} label="ports" />
              <BGStat value={2018} label="first release" />
            </div>
          )}
          {entry.name === "BGSwatchChip" && (
            <div class="group/strip flex h-24 max-w-md gap-[0.3rem]">
              {["blue", "lime", "purple"].map((n) => (
                <BGSwatchChip name={n} hex={palette.colors[n]?.hex ?? ""} />
              ))}
            </div>
          )}
          {entry.name === "BGSwatch" && (
            <div class="max-w-[180px]">
              <BGSwatch name="lime" color={palette.colors.lime as { hex: string; source: string }} />
            </div>
          )}
          {entry.name === "BGMarquee" && <BGMarquee items={targets.slice(0, 6).map((t) => t.name)} />}
          {entry.name === "BGSyntaxPreview" && (
            <div class="max-w-[640px]">
              <BGSyntaxPreview terminal />
            </div>
          )}
          {entry.name === "BGContrastTable" && <BGContrastTable />}
          {entry.name === "BGPaletteGroup" && (
            <BGPaletteGroup id="ui-demo-group" title="A palette group" count={3}>
              <p class="m-0 text-bf-fg-muted">Its content goes here.</p>
            </BGPaletteGroup>
          )}
          {entry.name === "BGFilterChips" && (
            <>
              <BGFilterChips kinds={kinds} />
              <p class="m-0 text-[0.82rem] text-bf-dim">Filters the BGAppCard grid in the next entry.</p>
            </>
          )}
          {entry.name === "BGAppCard" && (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))] gap-[0.9rem]" data-cards>
              {targets.slice(0, 3).map((t, i) => <BGAppCard target={t} index={i} base={base} />)}
            </div>
          )}
          {entry.name === "BGSplit" && (
            <BGSplit>
              <div slot="media" class="grid h-40 place-items-center rounded-[14px] border border-bf-border bg-bf-border-muted/72 text-bf-dim">
                media (left from 1024px)
              </div>
              <section>
                <h2 class="text-[1.1rem]">Instructions</h2>
                <p class="m-0 text-bf-fg-muted">The aside: at least 340px wide, or the layout stacks.</p>
              </section>
            </BGSplit>
          )}
          {entry.name === "BGBreadcrumbs" && <BGBreadcrumbs base={base} name={pi.name} />}
          {entry.name === "BGMarketCard" && market?.market && (
            <BGMarketCard label={market.market.label} url={market.market.url} name={market.name} />
          )}
          {entry.name === "BGDownloadCard" && pi.files[0] && (
            <div class="max-w-[560px]">
              <BGDownloadCard href={`${base}/themes/${pi.id}/${pi.files[0].path}`} label={pi.files[0].label} detail="download the file" />
            </div>
          )}
          {entry.name === "BGManualSteps" && <BGManualSteps steps={pi.steps} />}
          {entry.name === "BGCodeCard" && <BGCodeCard path="example.ts" code={'const palette = "bigface";'} truncated={false} />}
          {entry.name === "BGNextCard" && <BGNextCard href={`${base}/apps/${pi.id}/`} name={pi.name} />}
          {entry.name === "bgTextClass" && (
            <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 font-code text-[0.8rem]">
              {Object.entries(bgTextClass).map(([name, cls]) => (
                <span class={cls}>{name}</span>
              ))}
            </p>
          )}
        </BGEntry>
      ))
    }
  </section>

  <BGDivider />

  <section id="missing">
    <BGSectionHead eyebrow="05 — not yet" title="Not covered yet">
      This is a working catalogue, not a finished design system. Deliberately missing for now:
    </BGSectionHead>
    <BGCard tone="plate" className="p-5 md:p-6">
      <ul class="my-0 grid gap-2 pl-5">
        <li>
          <strong>Live demos for the rest of the native set.</strong> All {nativeSet.length}{" "}
          components the CLI ships are installed and upgrade-clean, and every one is registered above
          with its exports and variant keys; the ones outside the four deep entries have no live demo
          yet, and say nothing rather than pretending.
        </li>
        <li>
          <strong>Two system colours the registry paints with.</strong> Overlay scrims ask for
          <code>bg-black/10</code> and the slider thumb for <code>bg-white</code>. Tailwind's default
          colour scale is cleared here (bigface is palette-only), so both classes generate no CSS and
          the scrim stays invisible; fixing that means adding a colour to the palette, which is a
          design decision, not a component one.
        </li>
        <li>
          <strong>Pinned hover and focus states.</strong> They are live (point or tab) rather than frozen
          side by side: forcing them would mean editing the shadcn classes.
        </li>
        <li>
          <strong>Final props for {notFinal.length} BG components:</strong>{" "}
          {notFinal.map((e, i) => <><a href={`#bg-${e.name}`}>{e.name}</a>{i < notFinal.length - 1 ? ", " : ""}</>)}.
          They take page data (a raw <code>Target</code>, base and repo strings) instead of design types.
        </li>
        <li><strong>A light theme.</strong> Bigface is dark only, by design.</li>
        <li>
          <strong>Usage guidance.</strong> No do/don't notes or spacing rules yet; this page shows what
          exists, not how to compose it.
        </li>
      </ul>
    </BGCard>
  </section>
  </div>
</Base>
