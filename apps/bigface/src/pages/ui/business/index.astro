---
import BusinessShowcase from "../../../layouts/BusinessShowcase.astro";
import { BusinessPanels } from "./_showcase.tsx";
---

<BusinessShowcase
  title="Bigface Business: UI package"
  description="The business theme of @gjuoun/bigface-business-ui, light and dark, rendered live."
>
  <main class="mx-auto flex max-w-[1180px] flex-col gap-8 px-6 py-10">
    <header class="flex flex-col gap-2">
      <p class="font-mono text-xs uppercase tracking-[0.06em] text-muted-foreground">
        @gjuoun/bigface-business-ui
      </p>
      <h1 class="text-3xl font-semibold text-foreground">Business</h1>
      <p class="max-w-[62ch] text-muted-foreground">
        One theme, two modes. This page shows only the business package, so no other theme's variables
        are loaded here. Light is paper; dark is the native Bigface dark.
      </p>
    </header>
    <BusinessPanels />
  </main>
</BusinessShowcase>
