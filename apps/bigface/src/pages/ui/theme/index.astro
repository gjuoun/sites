---
import { BGBadge } from "@gjuoun/bigface-ui/components/bg/badge";
import BGEyebrow from "../../../components/bg/eyebrow.astro";
import BGSectionHead from "../../../components/bg/section-head.astro";
import Base from "../../../layouts/Base.astro";
import { ThemeControls, ThemeMatrix } from "../_themes.tsx";

// The theme gallery: six panels, one per theme × mode, each with room to be read. It lives apart from
// /ui/ on purpose — the catalogue page is a dense index, this page is a comparison surface.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  chrome={false}
  bleed
  noindex
  themable
  title="Bigface UI — themes"
  description="Business, console and play, each in light and dark, rendered live from the same components."
>
  <div class="px-[clamp(1rem,4vw,2.5rem)] pt-[clamp(0.75rem,3vw,1.5rem)] pb-20">
    <section data-reveal>
      <BGEyebrow>themes · business · console · play</BGEyebrow>
      <h1 class="text-[clamp(2.4rem,5.5vw,3.8rem)] leading-[1.02] font-extrabold">
        Three themes, <span class="bf-grad">two modes</span>
      </h1>
      <p class="bf-lead">
        One component set, six looks. A theme is data — a role map in
        <code>packages/ui/src/themes/roles.ts</code> rendered against the two palettes — so nothing here
        is a forked component: only <code>data-theme</code> and <code>data-mode</code> change. The
        switchers drive this page; the panels below keep their own pair so all six can be compared at
        once.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a class="font-code text-[0.82rem] text-bf-blue hover:underline" href={`${base}/ui/`}>
          ← back to the catalogue
        </a>
        <BGBadge tone="pill">live components</BGBadge>
      </div>
    </section>

    <div class="mt-[2rem]"><ThemeControls client:load /></div>

    <section class="mt-[1.6rem]">
      <BGSectionHead eyebrow="panels" title="Every combination, side by side">
        Each panel is a <code>BGThemeScope</code> with its own theme and mode: surfaces, ink, the primary
        plate, the tint badges, borders, radius and the focus ring — the same markup six times.
      </BGSectionHead>
      <ThemeMatrix />
    </section>
  </div>
</Base>
