---
import ConsoleShowcase from "../../../layouts/ConsoleShowcase.astro";
import { ConsolePanels } from "./_showcase.tsx";
---

<ConsoleShowcase
  title="Bigface Console: UI library"
  description="The console theme of @gjuoun/bigface-ui, light and dark, rendered live."
>
  <main class="mx-auto flex max-w-[1180px] flex-col gap-8 px-6 py-10">
    <header class="flex flex-col gap-2">
      <p class="font-mono text-xs uppercase tracking-[0.06em] text-muted-foreground">
        @gjuoun/bigface-ui
      </p>
      <h1 class="text-3xl font-semibold text-foreground">Console</h1>
      <p class="max-w-[62ch] text-muted-foreground">
        One theme, two modes. This page shows only the console theme, so no other theme's variables are
        loaded here. The site's library, unchanged.
      </p>
    </header>
    <ConsolePanels />
  </main>
</ConsoleShowcase>
