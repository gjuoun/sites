---
import type { Dict } from "../i18n/types.ts";
import CliBlock from "./CliBlock.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Hero from "./Hero.astro";
import Shot from "./Shot.astro";

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<Hero dict={dict} />

<section class="wrap">
  <h2 class="sec">{dict.home.heading}</h2>
  <Shot shot={dict.home.shot} />
</section>

<Features features={dict.features} />
<CliBlock cli={dict.cli} />
<Footer dict={dict} />
