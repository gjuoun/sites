---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { publishedPosts } from "../../lib/content-rules";

const series = (await getCollection("series")).map((e) => e.data).sort((a, b) => a.order - b.order);
const standalone = publishedPosts(await getCollection("posts"))
	.filter((p) => p.data.series === undefined)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Posts — Jun Guo" description="Numbered series and standalone posts by Jun Guo.">
	<h1>Posts</h1>
	<PostList items={series.map((s) => ({ href: `/posts/${s.slug}/`, title: s.title, summary: s.summary }))} />
	<PostList items={standalone.map((p) => ({ href: `/posts/${p.data.slug}/`, title: p.data.title, summary: p.data.summary }))} />
</Base>
