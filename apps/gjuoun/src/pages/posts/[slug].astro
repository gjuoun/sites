---
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { livePosts } from "../../lib/collections";
import { lessonsOf, pad, postHref } from "../../lib/posts";
import { PostPage } from "../../views/PostPage";

type Lesson = CollectionEntry<"posts">;
interface Props {
	post: Lesson;
	total: number;
	prev?: Lesson;
	next?: Lesson;
}

export async function getStaticPaths() {
	const posts = await livePosts();
	return posts.map((post) => {
		const siblings = post.data.series ? lessonsOf(posts, post.data.series) : [];
		const index = siblings.findIndex((q) => q.id === post.id);
		return {
			params: { slug: post.data.slug },
			props: {
				post,
				total: siblings.length,
				prev: index > 0 ? siblings[index - 1] : undefined,
				next:
					index >= 0 && index < siblings.length - 1
						? siblings[index + 1]
						: undefined,
			},
		};
	});
}

const { post, total, prev, next } = Astro.props;
const { title, summary, series, order, starter } = post.data;
const link = (p: Lesson | undefined, label: (p: Lesson) => string) =>
	p && { href: postHref(p.data.slug), label: label(p) };
---

<Base title={title} description={summary} type="article" starter={starter}>
	<PostPage
		title={title}
		summary={summary}
		html={post.rendered?.html ?? ""}
		kicker={series && `Lesson ${pad(order)} of ${total} in ${series}`}
		prev={link(prev, (p) => `← ${pad(p.data.order)} · ${p.data.title}`)}
		next={link(next, (p) => `${pad(p.data.order)} · ${p.data.title} →`)}
	/>
</Base>
