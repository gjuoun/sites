---
import { getCollection } from "astro:content";
import { ButtonLink } from "../components/ButtonLink";
import { Intro } from "../components/Intro";
import { PostList } from "../components/PostList";
import { ProjectGrid } from "../components/ProjectGrid";
import Base from "../layouts/Base.astro";
import { livePosts } from "../lib/collections";

const projects = (await getCollection("projects"))
	.map((e) => e.data)
	.sort((a, b) => a.order - b.order);
const seriesTitles = new Map(
	(await getCollection("series")).map(
		(e) => [e.data.slug, e.data.title] as const,
	),
);
const posts = await livePosts();
// Latest lessons: newest first. Ties keep series order, so a course with one date starts at lesson 1.
const latest = posts
	.slice()
	.sort(
		(a, b) =>
			b.data.date.valueOf() - a.data.date.valueOf() ||
			(a.data.order ?? 0) - (b.data.order ?? 0),
	)
	.slice(0, 3);
---

<Base description="Jun Guo: an introduction, a portfolio, and short numbered lessons on the things he builds." starter={true}>
	<h1>Jun Guo</h1>
	<section aria-labelledby="intro-heading">
		<h2 id="intro-heading" class="sr-only">Introduction</h2>
		<Intro />
	</section>
	<section aria-labelledby="portfolio-heading">
		<h2 id="portfolio-heading">Portfolio</h2>
		<ProjectGrid projects={projects} />
	</section>
	<!-- The posts are set off from the portfolio above them. -->
	<section class="mt-10 border-t-2 border-border pt-6 [&>h2]:mt-0" aria-labelledby="posts-heading">
		<h2 id="posts-heading">Posts</h2>
		<PostList
			numbered
			items={latest.map((p) => ({
				href: "/posts/" + p.data.slug + "/",
				title: p.data.title,
				summary: p.data.summary,
				order: p.data.order,
				kicker: p.data.series ? seriesTitles.get(p.data.series) : undefined,
			}))}
		/>
		<p class="not-prose mt-4"><ButtonLink variant="outline" href="/posts/" label="All posts" /></p>
	</section>
</Base>
