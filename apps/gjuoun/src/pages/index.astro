---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { livePosts } from "../lib/collections";
import { newestFirst, toPostItem } from "../lib/posts";
import { HomePage } from "../views/HomePage";

const projects = (await getCollection("projects"))
	.map((e) => e.data)
	.sort((a, b) => a.order - b.order);
// Latest lessons, each with its series title as the kicker.
const latest = newestFirst(await livePosts())
	.slice(0, 3)
	.map((p) => toPostItem(p, p.data.series));
---

<Base description="Jun Guo: an introduction, a portfolio, and short numbered lessons on the things he builds." starter={true}>
	<HomePage projects={projects} latest={latest} />
</Base>
