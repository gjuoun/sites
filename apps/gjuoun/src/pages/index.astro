---
import { getCollection } from "astro:content";
import PostList from "../components/PostList.astro";
import { renderProjectGrid } from "../components/ProjectGrid";
import ResumeFacts from "../components/ResumeFacts.astro";
import Base from "../layouts/Base.astro";
import { livePosts } from "../lib/collections";

const projects = (await getCollection("projects"))
	.map((e) => e.data)
	.sort((a, b) => a.order - b.order);
const seriesTitles = new Map(
	(await getCollection("series")).map(
		(e) => [e.data.slug, e.data.title] as const,
	),
);
const grid = renderProjectGrid(projects);
const posts = await livePosts();
// Latest lessons: newest first. Ties keep series order, so a course with one date starts at lesson 1.
const latest = posts
	.slice()
	.sort(
		(a, b) =>
			b.data.date.valueOf() - a.data.date.valueOf() ||
			(a.data.order ?? 0) - (b.data.order ?? 0),
	)
	.slice(0, 3);
---

<Base description="Portfolio, resume and numbered posts by Jun Guo." starter={true}>
	<h1>Jun Guo</h1>
	<section class="home-section" aria-labelledby="portfolio-heading">
		<h2 id="portfolio-heading">Portfolio</h2>
		<Fragment set:html={grid} />
	</section>
	<section class="home-section" aria-labelledby="resume-heading">
		<h2 id="resume-heading">Resume</h2>
		<ResumeFacts level={3} view="teaser" />
		<p><a class="button" href="/resume/">Full resume</a></p>
	</section>
	<section class="home-section" aria-labelledby="posts-heading">
		<h2 id="posts-heading">Posts</h2>
		<PostList
			numbered
			items={latest.map((p) => ({
				href: "/posts/" + p.data.slug + "/",
				title: p.data.title,
				summary: p.data.summary,
				order: p.data.order,
				kicker: p.data.series ? seriesTitles.get(p.data.series) : undefined,
			}))}
		/>
		<p><a class="button button-outline" href="/posts/">All posts</a></p>
	</section>
</Base>
