---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"projects">["data"];
}
const { project } = Astro.props;
---

<article>
	<h3>{project.name}</h3>
	<p>{project.summary}</p>
	{project.stack.length > 0 && <p>{project.stack.join(" · ")}</p>}
	{
		project.url || project.repo ? (
			<p class="actions">
				{project.url && <a class="button" href={project.url}>Visit</a>}
				{project.repo && <a class="button button-outline" href={project.repo}>Source</a>}
			</p>
		) : (
			<p>Private project. No public link.</p>
		)
	}
</article>
