---
import { MODE_STORAGE_KEY } from "@gjuoun/bigface-business-ui/lib/themes";
---

<button
	type="button"
	id="theme-toggle"
	class="group inline-flex min-h-7 min-w-7 cursor-pointer items-center justify-center gap-[0.35rem] border border-border bg-card p-[0.3rem] text-foreground aria-pressed:bg-muted focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-solid focus-visible:outline-foreground max-[23.5rem]:px-[0.4rem] max-[23.5rem]:py-[0.15rem] max-[23.5rem]:text-xs"
	aria-pressed="false"
	aria-label="Dark mode"
>
	<span class="inline-flex" aria-hidden="true">
		<svg class="group-aria-pressed:hidden" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z" /></svg>
		<svg class="hidden group-aria-pressed:inline-block" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3" /><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M13 3l-1 1M4 12l-1 1" /></svg>
	</span>
</button>
<script define:vars={{ storageKey: MODE_STORAGE_KEY }}>
	const root = document.documentElement;
	const button = document.getElementById("theme-toggle");
	const sync = () => button.setAttribute("aria-pressed", String(root.dataset.mode === "dark"));
	button.addEventListener("click", () => {
		root.dataset.mode = root.dataset.mode === "dark" ? "light" : "dark";
		try {
			localStorage.setItem(storageKey, root.dataset.mode);
		} catch (e) {}
		sync();
	});
	sync();
</script>
