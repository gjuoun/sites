---
import { CONTENT_LINK } from "../lib/classes";

interface Item {
	href: string;
	title: string;
	summary: string;
	order?: number;
	kicker?: string;
}
interface Props {
	items: Item[];
	numbered?: boolean;
}
const { items, numbered = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
// Lessons: a numbered list in series order. One grid per row: a fixed ordinal track, then the label, title and
// summary share one text track.
---

<ol class:list={[numbered ? "lesson-list" : "post-list", "not-prose list-none"]}>
	{
		items.map((item) => (
			<li class:list={["border-t border-border py-3", numbered && "grid grid-cols-[2.5ch_minmax(0,1fr)] gap-x-2"]}>
				{numbered && item.order !== undefined && <span class="ordinal font-mono text-foreground tabular-nums">{pad(item.order)}</span>}
				<div>
					{item.kicker && <p class="kicker text-[0.85rem] text-muted-foreground">{item.kicker}</p>}
					<a class={CONTENT_LINK} href={item.href}>{item.title}</a>
					<p class="summary mt-[0.15rem]">{item.summary}</p>
				</div>
			</li>
		))
	}
</ol>
