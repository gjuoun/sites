---
import { resume } from "../data/resume";
import { CONTENT_LINK } from "../lib/classes";

// The full facts live on /resume/. The home page shows only the teaser: headline, contact and summary,
// with the link to the full page. level is the heading that titles each section: 2 on the full page,
// 3 under the home page's Resume heading. Roles sit one level below.
interface Props {
	level: 2 | 3;
	view?: "full" | "teaser";
}
const { level, view = "full" } = Astro.props;
const Section = level === 2 ? "h2" : "h3";
const Role = level === 2 ? "h3" : "h4";
const c = resume.contact;
// Resume: dates sit in their own right-aligned column, one row per entry. Under 30rem the date sits above its entry.
const ENTRIES = "entries not-prose list-none";
const ENTRY =
	"entry grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 border-t border-border py-3 max-[30rem]:grid-cols-[minmax(0,1fr)]";
const DATE =
	"entry-date text-right whitespace-nowrap text-muted-foreground tabular-nums max-[30rem]:text-left";
const ROLE = "m-0 text-base font-bold text-foreground";
---

<p class="headline not-prose text-[1.1rem] text-foreground">{resume.headline}</p>
<p class="contact not-prose mt-6 mb-4">
	<a class={CONTENT_LINK} href={"mailto:" + c.email}>{c.email}</a> ·
	<a class={CONTENT_LINK} href={c.github}>github.com/gjuoun</a> ·
	<a class={CONTENT_LINK} href={c.linkedin}>linkedin.com/in/gjuoun</a> ·
	{c.location}
</p>
<p>{resume.summary}</p>

{
	view === "full" && (
		<>
			<Section>Experience</Section>
<ol class={ENTRIES}>
	{
		resume.roles.map((role) => (
			<li class={ENTRY}>
				<div>
					<Role class={ROLE}>{role.title}, {role.organization}</Role>
					<p class="kicker text-[0.85rem] text-muted-foreground">{role.location}</p>
					<ul class="bullets mt-[0.2rem] list-disc pl-[1.1rem]">
						{role.bullets.map((b) => <li>{b}</li>)}
					</ul>
				</div>
				<time class={DATE}>{role.start} – {role.end}</time>
			</li>
		))
	}
</ol>

<Section>Education</Section>
<ol class={ENTRIES}>
	{
		resume.education.map((e) => (
			<li class={ENTRY}>
				<div>
					<Role class={ROLE}>{e.school}</Role>
					<p class="mt-[0.1rem]">{e.degree}</p>
				</div>
				<time class={DATE}>{e.start} – {e.end}</time>
			</li>
		))
	}
</ol>

<Section>Skills</Section>
<p>{resume.skills.join(" · ")}</p>
		</>
	)
}
